{
    "welcomeFile": "index-cdn.html",
    "authenticationMethod": "route",
    "logout": {
        "logoutEndpoint": "/logout",
        "logoutPage": "/"
    },
    "routes": [
        {
            "source": "^/abc/(.*)$",
            "target": "$1",
            "destination": "abc",
            "authenticationType": "xsuaa"
        },
        {
            "source": "^/(.*)$",
            "target": "$1",
            "destination": "srv-api",
            "csrfProtection": true,
            "authenticationType": "xsuaa"
        }
    ]
}
